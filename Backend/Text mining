def identify_pest_from_image(image_data, county, language):
    """Use OpenAI Vision to identify pest/weed/disease from image."""

    # Convert image to base64
    image_bytes = image_data['content']
    base64_image = base64.b64encode(image_bytes).decode('utf-8')

    if language == "Spanish":
        prompt = """Analiza esta imagen e identifica cualquier plaga, maleza o enfermedad de plantas visible.

        Proporciona:
        1. El nombre común y científico (si es posible)
        2. Una breve descripción de lo que ves
        3. Palabras clave que podríamos usar para buscar hojas informativas relevantes

        Sé específico pero conciso."""
    else:
        prompt = """
        Analyze this image and identify any pests, weeds, or plant diseases visible.

        Provide:
        1. Common and scientific name (if possible)
        2. A brief description of what you see
        3. Keywords we could use to search for relevant fact sheets

        Be specific but concise."""

    response = client.chat.completions.create(
        model="gpt-4o",  # GPT-4 with vision
        messages=[
            {
                "role": "user",
                "content": [
                    {"type": "text", "text": prompt},
                    {
                        "type": "image_url",
                        "image_url": {
                            "url": f"data:image/jpeg;base64,{base64_image}"
                        }
                    }
                ]
            }
        ],
        max_tokens=500
    )

    return response.choices[0].message.content

