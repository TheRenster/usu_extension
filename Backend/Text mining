def generate_openai_response(question, papers, county, language):
    """Generate response using OpenAI with retrieved papers as context."""

    # Build context from papers
    context = ""
    for idx, (_, row) in enumerate(papers.iterrows(), 1):
        context += f"\nDocument {idx}: {row['title']}\n"
        context += f"Subject: {row['subject']}\n"
        context += f"Content excerpt: {row['content'][:500] if pd.notna(row['content']) else 'N/A'}\n"
        context += f"Link: {row['link']}\n"

    # Build system prompt
    if language == "Spanish":
        system_prompt = f"""Eres Agnes, una asistente útil de extensión agrícola para la Extensión de la Universidad Estatal de Utah.
        Ayudas a personas en el Condado de {county}.

        INSTRUCCIONES:
        1. Proporciona un breve resumen (2-3 oraciones) de lo que podría estar causando el problema
        2. Luego cita las hojas informativas relevantes con sus títulos y enlaces
        3. Termina preguntando si necesitan más ayuda

        Mantén las respuestas concisas y útiles."""

        user_prompt = f"Pregunta: {question}\n\nRecursos disponibles:{context}"
    else:
        system_prompt = f"""You are Agnes, a helpful agricultural extension assistant for Utah State University Extension.
        You help people in {county} County.

        INSTRUCTIONS:
        1. Provide a brief summary (2-3 sentences) of what might be causing the issue or answering their question
        2. Then cite the relevant fact sheets with their titles and links
        3. End by asking if they need more help

        Keep responses concise and helpful."""

        user_prompt = f"Question: {question}\n\nAvailable resources:{context}"

    # Call OpenAI
    response = client.chat.completions.create(
        model="gpt-4",  # or "gpt-3.5-turbo" for lower cost
        messages=[
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        temperature=0.7,
        max_tokens=600  # Increased to allow for summary + citations + follow-up
    )

    return response.choices[0].message.content

def get_county_contacts(county):
    """Retrieve ALL contact information for a specific county."""
    if contacts_df.empty:
        return []

    county_lower = county.lower().strip()

    # DEBUG: Print what we're searching for
    print(f"DEBUG: Searching for county: '{county_lower}'")
    print(f"DEBUG: Total contacts in database: {len(contacts_df)}")

    # Filter contacts where the county column contains the target county name
    matches = contacts_df[
        contacts_df['County'].str.lower().str.contains(county_lower, na=False, regex=False)
    ]

    # DEBUG: Print matches found
    print(f"DEBUG: Matches found: {len(matches)}")
    if not matches.empty:
        print(f"DEBUG: Matched counties: {matches['County'].tolist()}")

    if matches.empty:
        return []

    # Return list of contact dictionaries
    contacts = []
    for _, row in matches.iterrows():
        contacts.append({
            "name": row['Name'],
            "title": row['Title'],
            "county": row['County'],
            "email": row['Email'],
            "phone": row['Phone']
        })

    print(f"DEBUG: Returning {len(contacts)} contacts")
    return contacts


def extract_keywords(text):
    """Extract meaningful keywords from text by removing common words."""
    # Common words to filter out (English and Spanish)
    stop_words = {
        # English
        'a', 'an', 'the', 'is', 'are', 'was', 'were', 'be', 'been', 'being',
        'have', 'has', 'had', 'do', 'does', 'did', 'will', 'would', 'could',
        'should', 'may', 'might', 'can', 'i', 'you', 'he', 'she', 'it', 'we',
        'they', 'what', 'which', 'who', 'when', 'where', 'why', 'how', 'in',
        'on', 'at', 'to', 'for', 'of', 'with', 'from', 'about', 'my', 'your',
        'their', 'there', 'this', 'that', 'these', 'those',
        # Spanish
        'el', 'la', 'los', 'las', 'un', 'una', 'unos', 'unas', 'de', 'del',
        'en', 'por', 'para', 'con', 'sin', 'sobre', 'entre', 'es', 'son',
        'está', 'están', 'ser', 'estar', 'hay', 'mi', 'tu', 'su', 'que',
        'como', 'cual', 'cuando', 'donde', 'porque', 'si', 'no', 'y', 'o'
    }

    # Convert to lowercase and split into words
    words = re.findall(r'\b\w+\b', text.lower())

    # Filter out stop words and short words
    keywords = [w for w in words if w not in stop_words and len(w) > 2]

    return keywords


def is_spanish_document(row):
    """Check if a document is in Spanish based on title, subject, or filename."""
    spanish_indicators = ['spanish', 'español', 'spanish version', 'versión en español', 'en español']

    title = str(row['title']).lower() if pd.notna(row['title']) else ''
    subject = str(row['subject']).lower() if pd.notna(row['subject']) else ''
    filename = str(row['file_name']).lower() if pd.notna(row['file_name']) else ''

    for indicator in spanish_indicators:
        if indicator in title or indicator in subject or indicator in filename:
            return True

    return False


def calculate_relevance_score(question_keywords, title, subject, content):
    """Calculate relevance score based on keyword matches."""
    score = 0

    # Handle None values
    title_text = title.lower() if title else ''
    subject_text = subject.lower() if subject else ''
    content_text = content.lower() if content else ''

    # Count keyword matches with different weights
    for keyword in question_keywords:
        # Title matches are worth more
        if keyword in title_text:
            score += 5
        # Subject matches
        if keyword in subject_text:
            score += 3
        # Content matches
        if keyword in content_text:
            score += 1

    return score


def retrieve_relevant_papers(question, category, language, top_k=5):
    """Query the database for relevant fact sheets based on keywords and language."""
    conn = sqlite3.connect(DB_PATH)

    # Get all papers from database
    query = """
    SELECT id, file_name, title, authors, subject, creation_date, num_pages, link, content
    FROM pdfs
    """

    results = pd.read_sql_query(query, conn)
    conn.close()

    if results.empty:
        return results

    # If Spanish is selected, filter for Spanish content
    if language == "Spanish":
        # Create a mask for Spanish documents
        spanish_mask = results.apply(is_spanish_document, axis=1)
        results = results[spanish_mask]

        # If no Spanish documents found, return empty
        if results.empty:
            return pd.DataFrame()

    # Extract keywords from question only
    question_keywords = extract_keywords(question)

    # If no meaningful keywords extracted, return empty
    if not question_keywords:
        return pd.DataFrame()

    # After extracting keywords, add:
    # Calculate relevance scores
    results['relevance_score'] = results.apply(
        lambda row: calculate_relevance_score(
            question_keywords,
            row['title'],
            row['subject'],
            row['content'][:1000] if pd.notna(row['content']) else ''
        ),
        axis=1
    )

    # Filter by minimum relevance threshold
    results = results[results['relevance_score'] >= MIN_RELEVANCE_SCORE]

    # Sort by relevance and return top results
    results = results.sort_values('relevance_score', ascending=False)

    return results.head(top_k)

def ask_question(question, chat_log, county, category, language):
    """
    Process a user question using OpenAI with retrieved papers as context.
    Maintains chat history for context.
    """
    # Add user question to chat log
    chat_log.append({"role": "user", "content": question})

    # Retrieve relevant papers from database
    papers = retrieve_relevant_papers(question, category, language)

    # Handle case where no papers are found - provide county contact
    # Handle case where no papers are found - provide county contacts
    # Handle case where no papers are found - provide county contacts
    if papers.empty:
        contacts = get_county_contacts(county)

        if contacts:
            # Format multiple contacts
            contact_info = ""
            for contact in contacts:
                contact_info += f"""
{contact['name']}
{contact['title']}
{contact['email']}
{contact['phone']}

"""

            if language == "Spanish":
                fallback_response = f"""
No pude encontrar hojas informativas en nuestra base de datos que respondan directamente a su pregunta sobre "{question}".

Para ayuda específica del Condado de {county}, le recomiendo contactar a su oficina local de Extensión:

{contact_info}
Ellos pueden proporcionar orientación específica del condado y conectarlo con recursos adicionales.
"""
            else:
                fallback_response = f"""
I couldn't find fact sheets in our database that directly answer your question about "{question}".

For help specific to {county} County, I recommend reaching out to your local Extension office:

{contact_info}
They can provide county-specific guidance and connect you with additional resources.
"""
        else:
            if language == "Spanish":
                fallback_response = f"""
No pude encontrar hojas informativas relevantes para su pregunta sobre "{question}".

Por favor intente:
- Reformular su pregunta con palabras clave diferentes
- Seleccionar una categoría diferente
- Contactar a su oficina local de Extensión de USU para asistencia personalizada
"""
            else:
                fallback_response = f"""
I couldn't find relevant fact sheets for your question about "{question}".

Please try:
- Rephrasing your question with different keywords
- Selecting a different category
- Contacting your local USU Extension office for personalized assistance
"""

        chat_log.append({"role": "assistant", "content": fallback_response})
        return fallback_response, chat_log

    # Generate OpenAI response
    answer = generate_openai_response(question, papers, county, language)

    chat_log.append({"role": "assistant", "content": answer})
    return answer, chat_log

