#Convert csv into JSON
import pandas as pd
import json

# Read the CSV
df = pd.read_csv('County Contact info - Sheet1.csv')

# Create the JSON structure
contacts = []
for _, row in df.iterrows():
    # Split counties if they contain "and" or ","
    county_text = str(row['County'])

    # Handle formats like "Davis and Salt Lake Counties"
    if ' and ' in county_text.lower():
        counties = [c.strip().replace(' County', '').replace(' Counties', '')
                   for c in county_text.replace(' and ', ',').split(',')]
    else:
        counties = [county_text.replace(' County', '').replace(' Counties', '').strip()]

    contacts.append({
        "name": row['Name'],
        "title": row['Title'],
        "counties": counties,
        "email": row['Email'],
        "phone": str(row['Phone'])
    })

# Save to JSON
with open('contacts.json', 'w') as f:
    json.dump(contacts, f, indent=2)

print("JSON file created successfully!")

